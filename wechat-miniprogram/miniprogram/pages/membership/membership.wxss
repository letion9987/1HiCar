.page {
  padding: 24rpx;
  padding-bottom: 48rpx;
  background: #f7f7f7;
  min-height: 100vh;
}

.sub {
  display: block;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: #94a3b8;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

.card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #f9fafb;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.05);
}

.avatar-ph {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.mid {
  flex: 1;
  margin-left: 32rpx;
  min-width: 0;
}

.row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.badge.n {
  background: #f3f4f6;
  color: #6b7280;
}

.badge.s {
  background: #f1f5f9;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

.badge.g {
  background: #fffbeb;
  color: #b45309;
  border: 1rpx solid #fde68a;
}

.badge.p {
  background: #334155;
  color: #f8fafc;
}

.badge.d {
  background: linear-gradient(90deg, #8e2de2 0%, #4a00e0 100%);
  color: #fff;
}

.phone {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #94a3b8;
}
