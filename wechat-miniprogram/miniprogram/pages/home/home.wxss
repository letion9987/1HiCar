}

/* 完善资料：chooseAvatar + nickname（替代 getUserProfile） */
.profile-form {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}

.profile-hint {
  display: block;
  padding: 8rpx 8rpx 24rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.profile-avatar-btn {
  margin: 0 auto;
  padding: 0;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e2e8f0;
  border: 4rpx solid rgba(7, 193, 96, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar-preview {
  width: 100%;
  height: 100%;
}

.profile-avatar-tip {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.profile-sheet-top {
  flex-shrink: 0;
  padding: 24rpx 32rpx 8rpx;
  box-sizing: border-box;
}

.profile-hint-phoneok {
  color: #0f766e;
}

.profile-phone-btn {
  width: 100%;
  margin-top: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-sizing: border-box;
}

.profile-phone-btn::after {
  border: none;
}

.profile-phone-btn[disabled] {
  opacity: 0.65;
}

.profile-field {
  margin-top: 8rpx;
  padding: 0 32rpx 16rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.profile-field-nickname {
  margin-top: 0;
}

.profile-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.profile-nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #f1f5f9;
  border-radius: 16rpx;
  box-sizing: border-box;
}
