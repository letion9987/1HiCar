page {
  height: 100%;
  background-color: #f7f7f7;
}

.home-scroll {
  width: 100%;
  box-sizing: border-box;
}

.page-inner {
  box-sizing: border-box;
  width: 100%;
  /* Web Home 主列 pb-32 + 底栏：为固定 footer 留出空间 */
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
}

.card-flat {
  background: #fff;
  /* Web: px-4 pt-6 pb-4 + shadow-sm */
  padding: 48rpx 32rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 白底延申至状态栏；顶部内边距仅 safeArea.top/statusBarHeight（px，scroll-view 内 env 不可靠） */
.header.card-flat {
  padding-bottom: 32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.card {
  /* Web: m-4 p-4 rounded-xl shadow-sm */
  margin: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.avatar-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e2e8f0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(7, 193, 96, 0.25);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 36rpx;
  color: #94a3b8;
}

.header-text {
  flex: 1;
  min-width: 0;
}

.title-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
}

.sub-line {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.sub-line-guest {
  color: #64748b;
}

.loc-pill {
  font-size: 22rpx;
  font-weight: 600;
  color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  border: 1rpx solid rgba(7, 193, 96, 0.25);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  max-width: 320rpx;
  box-sizing: border-box;
}

.loc-pill-row {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 360rpx;
}

.ms-loc-pill-ico {
  font-family: "Material Symbols Outlined";
  font-size: 32rpx;
  line-height: 1;
  color: inherit;
  flex-shrink: 0;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 20;
}

.loc-pill-txt {
  flex-shrink: 0;
}

.loc-pill-txt-ellipsis {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes loc-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.ms-loc-spin {
  display: inline-block;
  animation: loc-spin 1s linear infinite;
}

.loc-pill-err {
  border-color: rgba(7, 193, 96, 0.35);
}

.mile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}

.mile-label {
  display: block;
  font-size: 26rpx;
  color: #475569;
}

.mile-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
  margin-top: 4rpx;
}

.mile-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.mile-badge-t {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
}

.dot-pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07C160;
}

.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  font-size: 40rpx;
  color: #334155;
}

.icon-btn[disabled] {
  opacity: 0.35;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  gap: 8rpx 4rpx;
}

.cal-head {
  font-size: 20rpx;
  font-weight: 700;
  color: #94a3b8;
  padding-bottom: 12rpx;
}

.cal-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  border-radius: 16rpx;
}

.cal-muted {
  color: #cbd5e1;
}

.cal-today {
  background: #07C160;
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.35);
}

.cal-sub {
  font-size: 16rpx;
  margin-top: 4rpx;
}

.sub-ok {
  color: #07c160;
}

.cal-today .sub-ok {
  color: rgba(255, 255, 255, 0.85);
}

.sub-muted {
  color: #94a3b8;
}

.map-wrap {
  margin: 32rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 24rpx;
  border: 1rpx solid #f1f5f9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.map {
  width: 100%;
  height: 360rpx;
}

.loc-card .loc-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 0;
}

/* Web：两地址行之间的竖线 ml-1 h-6 w-px bg-slate-100 */
.loc-connector {
  width: 2rpx;
  height: 48rpx;
  margin-left: 8rpx;
  background: #f1f5f9;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.dot-pickup {
  background: #07c160;
  box-shadow: 0 0 0 8rpx rgba(7, 193, 96, 0.2);
}

.dot-dropoff {
  background: #ff9800;
  box-shadow: 0 0 0 8rpx rgba(255, 152, 0, 0.2);
}

.loc-body {
  flex: 1;
  min-width: 0;
}

.loc-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.loc-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.loc-val.placeholder {
  color: #94a3b8;
  font-weight: 500;
}

.loc-warn {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.4;
}

.chev {
  font-size: 36rpx;
  color: #cbd5e1;
  margin-top: 8rpx;
}

.rows .row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.rows .row-last {
  border-bottom: none;
}

.row-icon {
  width: 48rpx;
  text-align: center;
  margin-right: 16rpx;
}

.row-t {
  flex: 1;
  font-size: 28rpx;
  color: #334155;
}

.row-v {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-right: 8rpx;
}

.row-remark {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fee-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.fee-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.fee-toggle {
  display: flex;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 999rpx;
  padding: 6rpx;
}

.tog {
  font-size: 20rpx;
  font-weight: 700;
  color: #07c160;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
}

.tog-on {
  background: #07C160;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.35);
}

.fee-line {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 10rpx 0;
}

.fee-k {
  color: #64748b;
}

.fee-num {
  font-weight: 600;
  color: #334155;
}

.fee-total {
  border-top: 1rpx solid #f1f5f9;
  margin-top: 8rpx;
  padding-top: 16rpx;
}

.fee-kb {
  font-weight: 700;
  color: #0f172a;
}

.fee-big {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF9800;
}

.fee-hint,
.fee-warn {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.fee-warn {
  color: #b45309;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #fff;
  /* Web: p-4 + shadow-bottomBar */
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.05);
}

.footer-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.footer-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
}

button.footer-btn::after {
  border: none;
}

/* 不可点：保持绿色系略浅，覆盖原生 disabled 发灰 */
.footer-btn.disabled,
.footer-btn[disabled],
button.footer-btn[disabled] {
  opacity: 1 !important;
  background: rgba(7, 193, 96, 0.42) !important;
  color: #fff !important;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.12) !important;
}

.rows-web {
  padding: 0;
  overflow: hidden;
  border: 1rpx solid #f1f5f9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.row-web {
  padding: 32rpx !important;
  justify-content: space-between;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  max-width: 65%;
}

.row-v-strong {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.fee-web {
  border: 1rpx solid #f1f5f9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
}

.fee-total-web {
  border-top-color: #f8fafc;
}

.fee-hint-muted {
  color: #94a3b8;
}

.mask-web {
  background: rgba(0, 0, 0, 0.4);
}

.sheet-web {
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.sheet-handle-web {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding-top: 16rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.sheet-handle-bar {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.sheet-hd-web {
  flex-shrink: 0;
  border-bottom: 1rpx solid #f8fafc;
  padding: 32rpx 48rpx;
  box-sizing: border-box;
}

.sheet-close-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-title-web {
  font-size: 36rpx;
  font-weight: 600;
  color: #0f172a;
}

.sheet-ft.sheet-ft-web {
  border-top: 1rpx solid #f1f5f9;
  padding: 32rpx 48rpx 80rpx;
  box-sizing: border-box;
}

.sheet-ok-web {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  font-size: 36rpx;
}

.sheet-ok-shadow {
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

/* 与 Web BottomSheet max-h-[84vh] 一致 */
.sheet-time {
  max-height: 84vh;
}

.sheet-body-time {
  padding: 40rpx 48rpx;
  box-sizing: border-box;
}

.time-sheet-stack {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
}

.blk-time,
.blk-pax {
  margin-bottom: 0;
}

.blk-head-web {
  margin-bottom: 32rpx;
}

.blk-t-web {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.blk-s-web {
  margin-top: 8rpx;
  margin-bottom: 0;
  font-size: 24rpx;
  color: #64748b;
}

.ms-sheet-close {
  font-size: 48rpx;
}

/* 与 Web WheelColumn：整行一条 bg-primary/10，无圆角；列间 slate-50 分隔 */
.time-wheel-wrap {
  position: relative;
  height: 352rpx;
  overflow: hidden;
}

.time-wheel-highlight {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 0;
  height: 96rpx;
  margin-top: -48rpx;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 0;
  pointer-events: none;
}

.time-wheel-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
  height: 352rpx;
  box-sizing: border-box;
}

.time-wheel-col {
  flex: 1;
  width: 0;
  height: 100%;
  box-sizing: border-box;
  border-right: 1rpx solid #f8fafc;
}

.time-wheel-col:last-child {
  border-right: none;
}

.time-wheel-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

/* Web: text-sm font-medium text-slate-400 */
.time-wheel-cell-off {
  font-size: 28rpx;
  font-weight: 500;
  color: #94a3b8;
}

/* Web: text-lg font-bold text-primary */
.time-wheel-cell-on {
  font-size: 36rpx;
  font-weight: 700;
  color: #07c160;
}

.pax-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 24rpx;
  background: #f8fafc;
  padding: 32rpx;
  box-sizing: border-box;
}

.pax-row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ms-pax-ico {
  font-size: 40rpx;
  color: #475569;
}

.pax-row-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #0f172a;
}

.pax-row-actions {
  display: flex;
  align-items: center;
  gap: 48rpx;
}

.pax-btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  line-height: 1;
}

.pax-btn::after {
  border: none;
}

.pax-btn-minus {
  border: 4rpx solid #e2e8f0;
}

.pax-btn-plus {
  border: 4rpx solid #07c160;
}

.ms-step {
  font-size: 40rpx;
  color: #94a3b8;
}

.ms-step-plus {
  color: #07c160;
}

.pax-num {
  min-width: 32rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
}

.quick-n-web {
  margin-top: 32rpx;
  gap: 24rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  max-height: 100vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  /* 白底贴齐屏幕底（含手势条区域），安全区内边距交给 footer / 内容区 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-tall {
  max-height: 100vh;
}

/* 拖块区域：横条仅 .sheet-handle-bar，避免与 web 版容器样式叠出双层条 */
.sheet-handle {
  width: 100%;
  background: transparent;
  border-radius: 0;
  margin: 0;
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f8fafc;
}

.sheet-close {
  width: 64rpx;
  font-size: 36rpx;
  color: #94a3b8;
}

.sheet-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.sheet-placeholder {
  width: 64rpx;
}

.sheet-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.sheet-body-grow {
  flex: 1;
  height: 0;
  min-height: 0;
  max-height: none;
}

.blk-t {
  display: block;
}

.blk-s {
  display: block;
}

.quick-n {
  display: flex;
  flex-wrap: wrap;
}

.qn {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #64748b;
}

.qn-on {
  border-color: #07c160;
  background: rgba(7, 193, 96, 0.08);
  color: #07c160;
  font-weight: 600;
}

.tag-hd {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tag {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: #f1f5f9;
  color: #475569;
}

.tag-on {
  background: #07C160;
  color: #fff;
}

.remark-area {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  font-size: 26rpx;
}

.sheet-ft {
  flex-shrink: 0;
  padding: 32rpx 48rpx 32rpx;
  border-top: 1rpx solid #f1f5f9;
  box-sizing: border-box;
}

.sheet-ok {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
}

.sheet-ok.sheet-ok-web {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
}

.sheet-ok::after {
  border: none;
}

.dep-top {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.dep-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.dep-big {
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #0f172a;
}

.yen {
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.dep-num {
  font-size: 100rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.dep-card {
  background: #f8fafc;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 0 32rpx;
}

.dep-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 16rpx 0;
}

.dep-row-k {
  color: #64748b;
}

.dep-row-v {
  font-weight: 600;
  color: #0f172a;
}

.dep-row-mid .dep-row-l {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dep-info-ico {
  font-family: "Material Symbols Outlined";
  font-size: 28rpx;
  color: #cbd5e1;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.dep-strong {
  border-top: 1rpx solid #e2e8f0;
  margin-top: 8rpx;
  padding-top: 24rpx;
}

.primary {
  color: #07c160 !important;
}

.dep-rules {
  padding: 0 8rpx 32rpx;
}

.dep-rule-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dep-rule-row:last-child {
  margin-bottom: 0;
}

.dep-rule-ico {
  font-family: "Material Symbols Outlined";
  font-size: 28rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  flex-shrink: 0;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.dep-rule-body {
  flex: 1;
  min-width: 0;
}

.dep-rule-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.dep-rule-s {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.sheet-ft-col {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.pay-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
