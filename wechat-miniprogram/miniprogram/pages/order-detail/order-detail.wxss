page {
  background: #f7f7f7;
  height: 100%;
}

.od-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f7f7;
  box-sizing: border-box;
}

.od-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

.od-page-inner {
  min-height: 0;
}

.nav-wrap {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
}

.status-bar-fill {
  width: 100%;
  background: #fff;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  background: #fff;
}

.nav-side {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  margin-left: -8rpx;
}

.nav-more {
  margin-right: -8rpx;
}

.ms-nav-ico {
  font-family: "Material Symbols Outlined";
  font-size: 48rpx;
  color: #334155;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.ms-nav-more {
  color: #475569;
}

.nav-title-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}

.nav-title-main {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
}

.nav-title-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #64748b;
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page {
  padding: 32rpx;
  background: #f7f7f7;
  min-height: 0;
}

/* 必须写在 .page 之后：否则 padding 简写会把底栏留白覆盖回 32rpx */
/* 与 Web OrderDetail `<main className="pb-32">` 一致：Tailwind 32 = 8rem → 256rpx */
.page.od-page-inner {
  padding-bottom: 256rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  /* Tailwind shadow-sm */
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* Web 信息卡 / 费用卡 p-5 */
.card.block {
  padding: 40rpx;
}

.hero-card {
  padding: 40rpx;
  border: none;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.hero-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.hero-row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-icon-wrap.ok {
  background: rgba(7, 193, 96, 0.1);
}

.hero-icon-wrap.primary {
  width: 128rpx;
  height: 128rpx;
  background: rgba(7, 193, 96, 0.1);
}

.hero-icon-wrap.muted {
  width: 128rpx;
  height: 128rpx;
  background: #f5f5f5;
}

.ms-hero-ico {
  font-family: "Material Symbols Outlined";
  font-size: 56rpx;
  color: #07c160;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.ms-hero-car {
  font-family: "Material Symbols Outlined";
  font-size: 60rpx;
  color: #07c160;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.ms-hero-cancel {
  font-family: "Material Symbols Outlined";
  font-size: 60rpx;
  color: #a3a3a3;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.hero-mid {
  flex: 1;
  min-width: 0;
}

.hero-t {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

/* Web text-xl：待确认 / 已取消主标题 */
.hero-t--xl {
  font-size: 40rpx;
  margin-top: 8rpx;
}

.hero-s {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #64748b;
}

.hero-side {
  text-align: right;
  flex-shrink: 0;
}

.hero-s2 {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
}

.hero-t2 {
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
}

.hero-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.pill {
  align-self: flex-start;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
}

.pill.warn {
  background: #fff7ed;
  color: #ea580c;
}

/* Web neutral-100 / neutral-600 */
.pill-neutral {
  background: #f5f5f5;
  color: #525252;
}

.map-section {
  margin-bottom: 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
  box-shadow: inset 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  min-height: 360rpx;
  aspect-ratio: 16 / 9;
}

.map {
  width: 100%;
  height: 100%;
  min-height: 360rpx;
}

.map-placeholder {
  min-height: 360rpx;
  aspect-ratio: 16 / 9;
  background: #e2e8f0;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  margin-bottom: 32rpx;
  padding: 0;
}

.block .veh-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f8fafc;
  margin-bottom: 32rpx;
}

.veh-t {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  flex: 1;
  padding-right: 24rpx;
}

.veh-ph {
  width: 160rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  flex-shrink: 0;
}

.row {
  display: flex;
  gap: 32rpx;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.row-last {
  margin-bottom: 0;
}

.ms-row-ico {
  font-family: "Material Symbols Outlined";
  font-size: 40rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  flex-shrink: 0;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.row-v {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
}

.row-v.sm {
  font-size: 28rpx;
  font-weight: 500;
}

.row-k {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.dot.p {
  background: #07c160;
}

.dot.d {
  background: #ff9800;
}

.addr {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
  line-height: 1.45;
}

.fee-hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.fee-hd-row--loose {
  margin-bottom: 40rpx;
}

.fee-hd {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.ms-info {
  font-family: "Material Symbols Outlined";
  font-size: 28rpx;
  color: #94a3b8;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

/* Web space-y-4：已结算费用明细 */
.fee-block--settle-gap .fee-row {
  margin-bottom: 32rpx;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  padding: 0;
  margin-bottom: 24rpx;
  color: #64748b;
}

.fee-block .fee-row:last-child {
  margin-bottom: 0;
}

.fee-row-sub {
  align-items: flex-start;
}

.fee-k-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.fee-k {
  color: #64748b;
}

.fee-sub {
  font-size: 20rpx;
  line-height: 1.2;
  color: #94a3b8;
}

.fee-v {
  font-weight: 600;
  color: #334155;
}

.fee-row-toll {
  padding-bottom: 16rpx;
}

.fee-row.total {
  border-top: 1rpx solid #f8fafc;
  margin-top: 8rpx;
  padding-top: 24rpx;
  align-items: baseline;
}

.completed-total {
  padding-top: 32rpx;
}

.fee-total-label {
  font-weight: 700;
  color: #0f172a;
}

.accent {
  font-size: 48rpx;
  font-weight: 700;
  color: #ff9800;
}

.deposit-row {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.fee-kb {
  font-weight: 600;
  color: #475569;
}

.fee-vb {
  font-weight: 700;
  color: #0f172a;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 24rpx;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f1f5f9;
  box-shadow: 0 -8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.f-btn {
  margin: 0;
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 24rpx;
}

.f-btn.outline {
  background: #fff;
  color: #334155;
  border: 2rpx solid #e2e8f0;
}

.f-btn.primary {
  background: #07c160;
  color: #fff;
  border: none;
  /* Web shadow-lg shadow-primary/20 */
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.2);
}

.f-btn.wide {
  flex: 2;
}

.f-btn.danger {
  color: #ef4444;
  border: 2rpx solid #e2e8f0;
  background: #fff;
}

.f-btn.full {
  flex: 1;
}

/* Web SettlementSheet：backdrop bg-black/40 */
.mask-web {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
}

/* BottomSheet：max-h-[84vh] rounded-t-xl shadow-2xl */
.sheet-settle {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  max-height: 100vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -16rpx 64rpx rgba(0, 0, 0, 0.15);
  box-sizing: border-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-web {
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.12);
}

/* handle: h-6 pt-2, bar h-1.5 w-10 bg-slate-200 */
.sheet-handle-web {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding-top: 16rpx;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.sheet-handle-bar {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
}

/* header: px-6 py-4 border-b border-slate-50 */
.sheet-hd-settle {
  flex-shrink: 0;
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  align-items: center;
  padding: 32rpx 48rpx;
  border-bottom: 1rpx solid #f8fafc;
}

.sheet-close-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8rpx;
}

.ms-close {
  font-family: "Material Symbols Outlined";
  font-size: 48rpx;
  color: #94a3b8;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

/* text-lg font-semibold text-slate-900 */
.sheet-title-settle {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.3;
}

.sheet-ph {
  width: 64rpx;
}

/* no-scrollbar + px-6 py-4，flex 占位撑满剩余高度 */
.sheet-scroll-settle {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 48rpx 24rpx;
}

/* mb-4 text-sm text-slate-500 */
.settle-intro {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  color: #64748b;
  margin-bottom: 32rpx;
}

/* space-y-4：仅相邻表单项之间 16px */
.settle-field + .settle-field {
  margin-top: 32rpx;
}

/* mb-1.5 px-1 */
.settle-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 8rpx;
}

/* text-sm font-semibold text-slate-700 */
.settle-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

/* text-xs text-slate-400 */
.settle-hint {
  font-size: 24rpx;
  color: #94a3b8;
}

/* h-12 rounded-xl border border-slate-200 bg-slate-50 px-4 */
.settle-input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  font-size: 28rpx;
  color: #0f172a;
}

/* mt-6 rounded-2xl border border-slate-100 bg-slate-50 p-4 */
.settle-summary {
  margin-top: 48rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  border: 1rpx solid #f1f5f9;
  background: #f8fafc;
}

/* mb-4 */
.settle-summary-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

/* font-medium text-slate-600 */
.settle-sum-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #475569;
}

/* text-3xl font-bold text-primary */
.settle-sum-big {
  font-size: 60rpx;
  font-weight: 700;
  color: #07c160;
  line-height: 1.1;
}

/* space-y-2 border-t border-slate-200 pt-3 text-xs text-slate-500 */
.settle-break {
  border-top: 1rpx solid #e2e8f0;
  padding-top: 24rpx;
}

.settle-break-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 24rpx;
  line-height: 1.35;
  color: #64748b;
  margin-bottom: 16rpx;
}

.settle-break-row:last-child {
  margin-bottom: 0;
}

/* font-medium text-slate-700 */
.settle-break-v {
  font-weight: 500;
  color: #334155;
}

/* footer: px-6 pt-4 pb-10 border-t border-slate-100 */
.sheet-ft-settle {
  flex-shrink: 0;
  padding: 32rpx 48rpx 80rpx;
  border-top: 1rpx solid #f1f5f9;
  background: #fff;
  box-sizing: border-box;
}

/* rounded-xl py-4 text-lg font-bold shadow-lg shadow-primary/20 */
.settle-confirm-btn {
  width: 100%;
  padding: 32rpx 24rpx;
  line-height: 1.25;
  border-radius: 24rpx;
  background: #07c160;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  border: none;
  box-sizing: border-box;
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.2);
}

.settle-confirm-btn::after {
  border: none;
}

.cd-mask {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 80rpx;
}

.cd-dialog {
  width: 100%;
  max-width: 600rpx;
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.cd-body {
  padding: 56rpx 48rpx 40rpx;
  text-align: center;
}

.cd-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  line-height: 1.35;
}

.cd-msg {
  display: block;
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: #666;
  line-height: 1.45;
  text-align: left;
}

.cd-actions {
  display: flex;
  border-top: 1rpx solid #e5e5e5;
}

.cd-btn {
  flex: 1;
  margin: 0;
  padding: 28rpx 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 0;
  border: none;
  background: #fff;
  line-height: 1.3;
}

.cd-btn::after {
  border: none;
}

.cd-cancel {
  color: #000;
  border-right: 1rpx solid #e5e5e5;
}

.cd-primary {
  color: #07c160;
}

.cd-danger {
  color: #fa5151;
}
