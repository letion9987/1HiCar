<view class="page">
  <view class="identity-section" wx:if="{{profile}}">
    <view class="identity-row">
      <image class="id-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view class="id-main">
        <view class="id-name-row">
          <text class="id-name">{{profile.displayName}}</text>
          <view class="id-membership id-mship-{{membershipBadgeClass}}" bindtap="onMembershipTap">
            <text wx:if="{{membershipLoading}}">会员同步中…</text>
            <text wx:elif="{{membershipLevelLabel}}">{{membershipLevelLabel}}</text>
            <text wx:else class="id-membership-muted">—</text>
          </view>
        </view>
        <text class="id-phone">{{profile.phoneMasked}}</text>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >
      {{item.label}}
    </view>
  </view>

  <view class="body">
    <view wx:if="{{listLoading}}" class="loading">加载中…</view>
    <block wx:elif="{{!currentList.length}}">
      <view class="empty">
        <view class="empty-icon-wrap">
          <text class="ms empty-ms">directions_car</text>
        </view>
        <text class="empty-t">暂无相关订单</text>
        <text class="empty-s">您还没有相关的包车订单，快去开启行程吧</text>
        <button class="empty-btn" bindtap="onGoHome">去预约</button>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{currentList}}" wx:key="id" class="order card {{item.dim ? 'order-dim' : ''}}">
        <view class="order-hd">
          <text class="order-id">订单号：{{item.id}}</text>
          <text class="badge {{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="order-loc {{item.dim ? 'order-loc-muted' : ''}}">
          <view class="loc-row">
            <view class="dot p" />
            <view>
              <text class="loc-k">起点</text>
              <text class="loc-v">{{item.from}}</text>
            </view>
          </view>
          <view class="loc-row">
            <view class="dot d" />
            <view>
              <text class="loc-k">终点</text>
              <text class="loc-v">{{item.toDisplay || '—'}}</text>
            </view>
          </view>
        </view>
        <view class="order-meta-row">
          <text class="ms order-meta-ico">schedule</text>
          <text class="order-meta-t">用车时间：{{item.useTime}}</text>
        </view>
        <view wx:if="{{item.remark}}" class="order-meta-row">
          <text class="ms order-meta-ico">notes</text>
          <text class="order-meta-t">备注：{{item.remark}}</text>
        </view>
        <view class="order-actions">
          <button
            wx:if="{{item.status === 'pending'}}"
            class="btn-outline"
            data-id="{{item.id}}"
            bindtap="onCancelOrder"
          >
            取消
          </button>
          <button
            wx:if="{{item.status === 'completed' || item.status === 'cancelled'}}"
            class="btn-danger"
            data-id="{{item.id}}"
            bindtap="onDeleteOrder"
          >
            删除
          </button>
          <button
            wx:if="{{item.status === 'pending' || item.status === 'ongoing' || item.status === 'completed'}}"
            class="btn-primary"
            data-id="{{item.id}}"
            data-status="{{item.status}}"
            bindtap="onViewDetail"
          >
            查看详情
          </button>
        </view>
      </view>
      <view wx:if="{{listLoadingMore}}" class="list-footer">正在加载…</view>
      <view wx:elif="{{listHasMore}}" class="list-footer list-footer-hint">上拉加载更多</view>
      <view wx:elif="{{currentList.length}}" class="list-footer list-footer-done">没有更多了</view>
    </block>
  </view>
</view>
