.ms {
  font-family: "Material Symbols Outlined";
  font-weight: normal;
  font-style: normal;
  font-size: 48rpx;
  line-height: 1;
  display: inline-block;
  vertical-align: middle;
  -webkit-font-smoothing: antialiased;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

.ms-sm {
  font-size: 40rpx;
}

.ms-slate {
  color: #94a3b8;
}

.ms-slate-light {
  color: #cbd5e1;
}

.ms-primary {
  color: #07c160;
}

.ms-dark {
  color: #1e293b;
}
